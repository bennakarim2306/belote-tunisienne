{
  "expo": {
    "name": "Belote Tunisienne",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "belotetn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.cardtableorient.b0nhgs",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.emergent.cardtableorient.b0nhgs"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Keep JNI bridge classes (React Native native calls)\n-keep class com.facebook.jni.** { *; }\n# Google Mobile Ads — safety net on top of the SDK's own consumer rules\n-keep public class com.google.android.gms.ads.** { public *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5073907506851296~9016046511",
          "iosAppId": "ca-app-pub-5073907506851296~2491413453",
          "userTrackingUsageDescription": "This identifier will be used to show you ads that are more relevant to you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-build-properties",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
